<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MYMSOUND</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --main: #8b5cf6;
    --main2: #6d28d9;
    --bg: #080808;
    --card: #121212;
    --card2: #181818;
    --text: #fff;
    --muted: #999;
    --danger: #ef4444;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

/* HEADER */

header {
    height: 70px;
    background: #0d0d0d;
    border-bottom: 1px solid #222;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 35px;
    position: sticky;
    top: 0;
    z-index: 50;
}

.logo {
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 2px;
    color: var(--main);
}

nav {
    display: flex;
    gap: 25px;
}

nav button {
    background: none;
    border: 0;
    color: #bbb;
    cursor: pointer;
    font-size: 15px;
}

nav button:hover {
    color: white;
}

.profile-mini {
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--main);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

/* PAGES */

.page {
    display: none;
    max-width: 1200px;
    margin: auto;
    padding: 35px 20px 100px;
}

.page.active {
    display: block;
}

/* LOGIN */

.login-screen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        radial-gradient(circle at top, #241044, #080808 55%);
}

.login-box {
    width: 430px;
    background: #111;
    border: 1px solid #292929;
    border-radius: 22px;
    padding: 35px;
    box-shadow: 0 20px 70px #000;
}

.login-logo {
    text-align: center;
    font-size: 38px;
    font-weight: 900;
    color: var(--main);
    margin-bottom: 10px;
}

.login-sub {
    text-align: center;
    color: #999;
    margin-bottom: 30px;
}

.input {
    width: 100%;
    padding: 14px;
    margin-bottom: 13px;
    border-radius: 10px;
    border: 1px solid #333;
    background: #191919;
    color: white;
    outline: none;
}

.input:focus {
    border-color: var(--main);
}

.primary {
    width: 100%;
    padding: 14px;
    border: 0;
    border-radius: 10px;
    background: var(--main);
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.primary:hover {
    background: var(--main2);
}

.role-title {
    color: #aaa;
    margin: 15px 0 10px;
}

.roles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.role {
    padding: 15px 5px;
    border-radius: 10px;
    background: #1a1a1a;
    border: 1px solid #333;
    color: #aaa;
    cursor: pointer;
    text-align: center;
}

.role.selected {
    border-color: var(--main);
    background: #24163e;
    color: white;
}

/* HERO */

.hero {
    background: linear-gradient(135deg, #171020, #0e0e0e);
    border: 1px solid #28202f;
    border-radius: 22px;
    padding: 45px;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

.hero h1 span {
    color: var(--main);
}

.hero p {
    color: #aaa;
    max-width: 600px;
    line-height: 1.6;
}

/* SECTION */

.section-title {
    margin: 30px 0 15px;
    font-size: 23px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.card {
    background: var(--card);
    border: 1px solid #252525;
    border-radius: 16px;
    padding: 20px;
}

.card:hover {
    border-color: #444;
}

.card h3 {
    margin-bottom: 8px;
}

.card p {
    color: var(--muted);
    line-height: 1.5;
}

.tag {
    display: inline-block;
    margin-top: 12px;
    background: #25183d;
    color: #c4a6ff;
    border-radius: 20px;
    padding: 5px 10px;
    font-size: 12px;
}

/* FEED */

.post {
    background: var(--card);
    border: 1px solid #252525;
    border-radius: 17px;
    padding: 20px;
    margin-bottom: 15px;
}

.post-user {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 15px;
}

.post-user small {
    color: #888;
}

.post-content {
    font-size: 17px;
    line-height: 1.5;
}

.post-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.action {
    background: #1d1d1d;
    border: 0;
    color: #aaa;
    padding: 9px 13px;
    border-radius: 9px;
    cursor: pointer;
}

.action:hover {
    color: white;
}

/* SHORTS */

.shorts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.short {
    height: 330px;
    border-radius: 17px;
    background: linear-gradient(150deg, #35185c, #111);
    border: 1px solid #333;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 17px;
}

/* FLOAT BUTTON */

.floating {
    position: fixed;
    right: 25px;
    bottom: 25px;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    border: 0;
    background: var(--main);
    color: white;
    font-size: 30px;
    cursor: pointer;
    box-shadow: 0 10px 35px #000;
    z-index: 100;
}

/* CREATE MENU */

.create-menu {
    position: fixed;
    right: 25px;
    bottom: 95px;
    width: 230px;
    background: #151515;
    border: 1px solid #333;
    border-radius: 15px;
    padding: 10px;
    display: none;
    z-index: 99;
}

.create-menu.show {
    display: block;
}

.create-menu button {
    width: 100%;
    text-align: left;
    padding: 13px;
    margin: 3px 0;
    background: transparent;
    color: white;
    border: 0;
    border-radius: 9px;
    cursor: pointer;
}

.create-menu button:hover {
    background: #252525;
}

/* MODAL */

.modal-bg {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 20px;
}

.modal-bg.show {
    display: flex;
}

.modal {
    width: 500px;
    max-width: 100%;
    background: #121212;
    border: 1px solid #333;
    border-radius: 18px;
    padding: 25px;
}

.modal h2 {
    margin-bottom: 20px;
}

.close {
    float: right;
    background: none;
    border: 0;
    color: #999;
    font-size: 22px;
    cursor: pointer;
}

textarea {
    width: 100%;
    min-height: 130px;
    resize: vertical;
    background: #191919;
    border: 1px solid #333;
    color: white;
    border-radius: 10px;
    padding: 13px;
    margin-bottom: 12px;
    outline: none;
}

.file {
    width: 100%;
    background: #191919;
    border: 1px dashed #444;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 12px;
    color: #aaa;
}

/* PROFILE */

.profile-head {
    background: var(--card);
    border: 1px solid #292929;
    border-radius: 20px;
    padding: 30px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
}

.big-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: var(--main);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 35px;
    font-weight: bold;
}

.profile-info {
    flex: 1;
}

.profile-info p {
    color: #999;
    margin-top: 5px;
}

.profile-menu {
    position: relative;
}

.dots {
    background: #222;
    border: 0;
    color: white;
    font-size: 22px;
    border-radius: 8px;
    padding: 5px 12px;
    cursor: pointer;
}

.dots-menu {
    position: absolute;
    right: 0;
    top: 45px;
    width: 170px;
    background: #191919;
    border: 1px solid #333;
    border-radius: 10px;
    display: none;
    overflow: hidden;
}

.dots-menu.show {
    display: block;
}

.dots-menu button {
    width: 100%;
    padding: 12px;
    border: 0;
    background: transparent;
    color: white;
    text-align: left;
    cursor: pointer;
}

.dots-menu button:hover {
    background: #292929;
}

.dots-menu .danger {
    color: #ff6666;
}

/* SETTINGS */

.settings {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 20px;
}

.settings-nav,
.settings-content {
    background: var(--card);
    border: 1px solid #282828;
    border-radius: 16px;
    padding: 20px;
}

.settings-nav button {
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 0;
    color: #aaa;
    text-align: left;
    cursor: pointer;
    border-radius: 8px;
}

.settings-nav button:hover {
    background: #222;
    color: white;
}

.color-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 15px;
}

.color {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 3px solid #333;
    cursor: pointer;
}

.color:hover {
    border-color: white;
}

.color.purple { background: #8b5cf6; }
.color.black { background: #000; }
.color.white { background: #fff; }
.color.red { background: #ef4444; }
.color.yellow { background: #eab308; }
.color.blue { background: #2563eb; }
.color.gray { background: #6b7280; }

/* MESSAGES */

.messages {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 500px;
    background: var(--card);
    border: 1px solid #292929;
    border-radius: 17px;
    overflow: hidden;
}

.conversations {
    border-right: 1px solid #292929;
}

.conversation {
    padding: 15px;
    border-bottom: 1px solid #222;
    cursor: pointer;
}

.conversation:hover {
    background: #1d1d1d;
}

.chat {
    display: flex;
    flex-direction: column;
}

.chat-top {
    padding: 17px;
    border-bottom: 1px solid #292929;
}

.chat-body {
    flex: 1;
    padding: 20px;
}

.message {
    display: inline-block;
    background: var(--main);
    padding: 10px 14px;
    border-radius: 15px;
    margin-bottom: 10px;
}

.chat-input {
    display: flex;
    gap: 10px;
    padding: 15px;
    border-top: 1px solid #292929;
}

.chat-input input {
    flex: 1;
    background: #1b1b1b;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 12px;
    color: white;
}

.chat-input button {
    background: var(--main);
    border: 0;
    color: white;
    padding: 0 18px;
    border-radius: 10px;
}

/* MOBILE */

@media(max-width: 800px) {
    nav {
        display: none;
    }

    .grid,
    .shorts {
        grid-template-columns: 1fr 1fr;
    }

    .settings,
    .messages {
        grid-template-columns: 1fr;
    }

    .conversations {
        border-right: 0;
        border-bottom: 1px solid #292929;
    }

    .hero h1 {
        font-size: 32px;
    }
}

@media(max-width: 500px) {
    .grid,
    .shorts {
        grid-template-columns: 1fr;
    }

    header {
        padding: 0 15px;
    }

    .login-box {
        padding: 25px;
    }
}
</style>
</head>

<body>

<!-- GİRİŞ / KAYIT -->

<div id="auth" class="login-screen">

    <div class="login-box">

        <div class="login-logo">MYMSOUND</div>

        <div class="login-sub">
            Müzik dünyasının yeni topluluğu
        </div>

        <input id="email" class="input" type="email" placeholder="Gmail adresin">

        <input id="nickname" class="input" type="text" placeholder="Mahlasın">

        <div class="role-title">Mesleğini seç</div>

        <div class="roles">

            <div class="role" onclick="selectRole(this,'REPÇİ')">
                🎤<br>REPÇİ
            </div>

            <div class="role" onclick="selectRole(this,'DJ')">
                🎧<br>DJ
            </div>

            <div class="role" onclick="selectRole(this,'PROD')">
                🎛️<br>PROD
            </div>

        </div>

        <br>

        <button class="primary" onclick="register()">
            GİRİŞ YAP / KAYIT OL
        </button>

        <p style="text-align:center;color:#666;margin-top:15px;font-size:12px">
            Demo sürümünde Gmail onay kodu zorunlu değildir.
        </p>

    </div>

</div>


<!-- ANA UYGULAMA -->

<div id="app" style="display:none">

<header>

    <div class="logo">MYMSOUND</div>

    <nav>
        <button onclick="showPage('home')">Ana Sayfa</button>
        <button onclick="showPage('explore')">Keşfet</button>
        <button onclick="showPage('shorts')">Short İçerik</button>
        <button onclick="showPage('messages')">Mesajlar</button>
        <button onclick="showPage('profile')">Profil</button>
        <button onclick="showPage('settings')">Ayarlar</button>
    </nav>

    <div class="profile-mini">
        <span id="miniName">Kullanıcı</span>
        <div class="avatar" id="miniAvatar">M</div>
    </div>

</header>


<!-- ANA SAYFA -->

<section id="home" class="page active">

    <div class="hero">
        <h1>MYM<span>SOUND</span></h1>
        <p id="welcomeText">
            Müzik dünyasına hoş geldin.
        </p>
    </div>

    <h2 class="section-title">Senin için</h2>

    <div class="grid" id="personalCards"></div>

    <h2 class="section-title">Topluluk Akışı</h2>

    <div id="feed">

        <div class="post">

            <div class="post-user">
                <div class="avatar">M</div>

                <div>
                    <b>MR AKTİVTY</b><br>
                    <small>PROD · 2 saat önce</small>
                </div>
            </div>

            <div class="post-content">
                Yeni beat üzerinde çalışıyorum 🔥
            </div>

            <div class="post-actions">
                <button class="action" onclick="like(this)">❤️ 0</button>
                <button class="action">💬 Yorum</button>
                <button class="action">↗ Paylaş</button>
            </div>

        </div>

        <div class="post">

            <div class="post-user">
                <div class="avatar">R</div>

                <div>
                    <b>Rapper01</b><br>
                    <small>REPÇİ · 4 saat önce</small>
                </div>
            </div>

            <div class="post-content">
                Yeni parça yakında geliyor. 🎤
            </div>

            <div class="post-actions">
                <button class="action" onclick="like(this)">❤️ 0</button>
                <button class="action">💬 Yorum</button>
                <button class="action">↗ Paylaş</button>
            </div>

        </div>

    </div>

    <h2 class="section-title">Short İçerikler</h2>

    <div class="shorts">

        <div class="short">
            <b>🎤 Yeni freestyle</b>
            <small>@rapper01</small>
        </div>

        <div class="short">
            <b>🎧 DJ set</b>
            <small>@djkaan</small>
        </div>

        <div class="short">
            <b>🎛️ Beat yapımı</b>
            <small>@mractivity</small>
        </div>

        <div class="short">
            <b>🔥 Stüdyo</b>
            <small>@poizi</small>
        </div>

    </div>

</section>


<!-- KEŞFET -->

<section id="explore" class="page">

    <h1>Keşfet</h1>

    <p style="color:#888;margin-top:8px">
        Yeni rapçiler, DJ'ler ve prodüktörler keşfet.
    </p>

    <div class="grid" style="margin-top:25px">

        <div class="card">
            <h3>🎤 Poizi</h3>
            <p>REPÇİ</p>
            <span class="tag">Takip Et</span>
        </div>

        <div class="card">
            <h3>🎧 DJ Kaan</h3>
            <p>DJ</p>
            <span class="tag">Takip Et</span>
        </div>

        <div class="card">
            <h3>🎛️ MR AKTİVTY</h3>
            <p>PROD</p>
            <span class="tag">Takip Et</span>
        </div>

    </div>

</section>


<!-- SHORTS -->

<section id="shorts" class="page">

    <h1>Short İçerikler</h1>

    <p style="color:#888;margin:8px 0 25px">
        Reels tarzı kısa içerikleri keşfet.
    </p>

    <div class="shorts">

        <div class="short">
            <b>🎤 Freestyle #1</b>
            <small>@rapper01</small>
        </div>

        <div class="short">
            <b>🎧 DJ Performans</b>
            <small>@djkaan</small>
        </div>

        <div class="short">
            <b>🎛️ Beat Making</b>
            <small>@mractivity</small>
        </div>

        <div class="short">
            <b>🔥 Stüdyo</b>
            <small>@poizi</small>
        </div>

        <div class="short">
            <b>🎤 Yeni Verse</b>
            <small>@rapx</small>
        </div>

        <div class="short">
            <b>🎧 Mix</b>
            <small>@djxx</small>
        </div>

    </div>

</section>


<!-- MESAJLAR -->

<section id="messages" class="page">

    <h1 style="margin-bottom:20px">Mesajlar</h1>

    <div class="messages">

        <div class="conversations">

            <div class="conversation">
                <b>Poizi</b>
                <small style="display:block;color:#777">
                    Selam 👋
                </small>
            </div>

            <div class="conversation">
                <b>DJ Kaan</b>
                <small style="display:block;color:#777">
                    Beat hazır mı?
                </small>
            </div>

            <div class="conversation">
                <b>Rapper01</b>
                <small style="display:block;color:#777">
                    Yeni parça...
                </small>
            </div>

        </div>

        <div class="chat">

            <div class="chat-top">
                <b>Poizi</b>
            </div>

            <div class="chat-body" id="chatBody">

                <div class="message">
                    Selam 👋
                </div>

                <br>

                <div class="message">
                    Yeni parçayı dinledin mi?
                </div>

            </div>

            <div class="chat-input">

                <input
                    id="messageInput"
                    placeholder="Mesaj yaz..."
                >

                <button onclick="sendMessage()">
                    Gönder
                </button>

            </div>

        </div>

    </div>

</section>


<!-- PROFİL -->

<section id="profile" class="page">

    <div class="profile-head">

        <div class="big-avatar" id="bigAvatar">
            M
        </div>

        <div class="profile-info">

            <h2 id="profileName">
                Kullanıcı
            </h2>

            <p id="profileRole">
                REPÇİ
            </p>

            <p>
                MYMSOUND kullanıcısı
            </p>

        </div>

        <div class="profile-menu">

            <button class="dots" onclick="toggleDots()">
                ⋮
            </button>

            <div id="dotsMenu" class="dots-menu">

                <button onclick="shareProfile()">
                    📤 Hesabı Paylaş
                </button>

                <button class="danger" onclick="blockUser()">
                    🚫 Engelle
                </button>

            </div>

        </div>

    </div>

    <h2 class="section-title">Paylaşımlar</h2>

    <div class="card">
        Henüz paylaşım yok.
    </div>

</section>


<!-- AYARLAR -->

<section id="settings" class="page">

    <h1 style="margin-bottom:25px">
        Ayarlar
    </h1>

    <div class="settings">

        <div class="settings-nav">

            <button onclick="settingsMessage('Hesap')">
                👤 Hesap
            </button>

            <button onclick="settingsMessage('Görünüm')">
                🎨 Görünüm
            </button>

            <button onclick="settingsMessage('Hareketlerim')">
                ❤️ Hareketlerim
            </button>

            <button onclick="settingsMessage('Engellenenler')">
                🚫 Engellenenler
            </button>

            <button onclick="logout()">
                🚪 Çıkış Yap
            </button>

        </div>

        <div class="settings-content">

            <h2>Hesap</h2>

            <p style="color:#888;margin-top:8px">
                Profil bilgilerini yönet.
            </p>

            <br>

            <input
                id="newName"
                class="input"
                placeholder="Yeni mahlas"
            >

            <button
                class="primary"
                onclick="changeName()"
            >
                İsmi Değiştir
            </button>

            <p
                id="nameLimit"
                style="color:#777;margin-top:12px"
            >
                İsim değiştirme hakkı: 3 / 3
            </p>

            <hr style="border-color:#292929;margin:25px 0">

            <h2>Ana Renk</h2>

            <p style="color:#888;margin-top:8px">
                MYMSOUND görünümünün rengini seç.
            </p>

            <div class="color-list">

                <div class="color purple"
                     onclick="changeColor('#8b5cf6')"></div>

                <div class="color black"
                     onclick="changeColor('#555')"></div>

                <div class="color white"
                     onclick="changeColor('#f5f5f5')"></div>

                <div class="color red"
                     onclick="changeColor('#ef4444')"></div>

                <div class="color yellow"
                     onclick="changeColor('#eab308')"></div>

                <div class="color blue"
                     onclick="changeColor('#2563eb')"></div>

                <div class="color gray"
                     onclick="changeColor('#6b7280')"></div>

            </div>

            <hr style="border-color:#292929;margin:25px 0">

            <h2>Hareketlerim</h2>

            <p style="color:#888;margin-top:10px">
                Beğendiğin ve etkileşim yaptığın içerikler burada
                gösterilecek.
            </p>

            <br>

            <h2>Engellenenler</h2>

            <p
                id="blockedText"
                style="color:#888;margin-top:10px"
            >
                Henüz engellenen hesap yok.
            </p>

        </div>

    </div>

</section>


<!-- SAĞ ALT + -->

<button
    class="floating"
    onclick="toggleCreate()"
>
    +
</button>

<div
    id="createMenu"
    class="create-menu"
>

    <button onclick="openModal('song')">
        🎵 Şarkı Yayınla
    </button>

    <button onclick="openModal('community')">
        💬 Topluluk Mesajı
    </button>

    <button onclick="openModal('short')">
        📱 Short İçerik
    </button>

</div>


<!-- MODAL -->

<div
    id="modalBg"
    class="modal-bg"
>

    <div class="modal">

        <button
            class="close"
            onclick="closeModal()"
        >
            ×
        </button>

        <h2 id="modalTitle">
            Paylaş
        </h2>

        <div id="modalContent"></div>

    </div>

</div>

</div>


<script>

/* USER */

let user = {
    email: "",
    nickname: "",
    role: ""
};

let selectedRole = "";

function selectRole(element, role) {

    document.querySelectorAll(".role")
        .forEach(x => x.classList.remove("selected"));

    element.classList.add("selected");

    selectedRole = role;
}


function register() {

    const email =
        document.getElementById("email").value.trim();

    const nickname =
        document.getElementById("nickname").value.trim();

    if (!email || !nickname || !selectedRole) {

        alert("Gmail, mahlas ve meslek seçimi zorunlu.");

        return;
    }

    user = {
        email: email,
        nickname: nickname,
        role: selectedRole
    };

    localStorage.setItem(
        "mymsoundUser",
        JSON.stringify(user)
    );

    startApp();
}


function startApp() {

    document.getElementById("auth").style.display = "none";

    document.getElementById("app").style.display = "block";

    document.getElementById("miniName").textContent =
        user.nickname;

    document.getElementById("profileName").textContent =
        user.nickname;

    document.getElementById("profileRole").textContent =
        user.role;

    document.getElementById("miniAvatar").textContent =
        user.nickname.charAt(0).toUpperCase();

    document.getElementById("bigAvatar").textContent =
        user.nickname.charAt(0).toUpperCase();

    document.getElementById("welcomeText").textContent =
        "Hoş geldin " + user.nickname +
        ". " + user.role +
        " için hazırlanan MYMSOUND alanındasın.";

    personalizeHome();
}


function personalizeHome() {

    const box =
        document.getElementById("personalCards");

    let cards = "";

    if (user.role === "REPÇİ") {

        cards = `
        <div class="card">
            <h3>🎤 Rap Akışı</h3>
            <p>Yeni rapçiler, parçalar ve freestyle içerikleri.</p>
            <span class="tag">REPÇİ</span>
        </div>

        <div class="card">
            <h3>🔥 Battle</h3>
            <p>Rap battle içeriklerini keşfet.</p>
            <span class="tag">BATTLE</span>
        </div>

        <div class="card">
            <h3>🎙️ Freestyle</h3>
            <p>Yeni freestyle videolarını izle.</p>
            <span class="tag">SHORT</span>
        </div>
        `;

    } else if (user.role === "DJ") {

        cards = `
        <div class="card">
            <h3>🎧 DJ Akışı</h3>
            <p>DJ setleri ve yeni mixleri keşfet.</p>
            <span class="tag">DJ</span>
        </div>

        <div class="card">
            <h3>🎶 Setler</h3>
            <p>Yeni DJ performanslarını izle.</p>
            <span class="tag">SET</span>
        </div>

        <div class="card">
            <h3>🔥 Short</h3>
            <p>DJ kısa içeriklerini keşfet.</p>
            <span class="tag">SHORT</span>
        </div>
        `;

    } else {

        cards = `
        <div class="card">
            <h3>🎛️ Prod Akışı</h3>
            <p>Beat, mix ve prodüksiyon içeriklerini keşfet.</p>
            <span class="tag">PROD</span>
        </div>

        <div class="card">
            <h3>🥁 Beatler</h3>
            <p>Yeni beatleri ve prodüktörleri keşfet.</p>
            <span class="tag">BEAT</span>
        </div>

        <div class="card">
            <h3>🎚️ Stüdyo</h3>
            <p>Prodüksiyon ve stüdyo içeriklerini izle.</p>
            <span class="tag">STÜDYO</span>
        </div>
        `;
    }

    box.innerHTML = cards;
}


/* SAYFALAR */

function showPage(id) {

    document.querySelectorAll(".page")
        .forEach(page => page.classList.remove("active"));

    document.getElementById(id)
        .classList.add("active");

    window.scrollTo(0,0);
}


/* CREATE */

function toggleCreate() {

    document
        .getElementById("createMenu")
        .classList.toggle("show");
}


function openModal(type) {

    document
        .getElementById("createMenu")
        .classList.remove("show");

    const bg =
        document.getElementById("modalBg");

    const title =
        document.getElementById("modalTitle");

    const content =
        document.getElementById("modalContent");

    bg.classList.add("show");

    if (type === "song") {

        title.textContent = "🎵 Şarkı Yayınla";

        content.innerHTML = `

            <input
                id="songName"
                class="input"
                placeholder="Şarkı adı *"
            >

            <textarea
                id="songDescription"
                placeholder="Açıklama (zorunlu değil)"
            ></textarea>

            <label class="file">
                Şarkı dosyası — MP3 veya WAV
                <input
                    id="songFile"
                    type="file"
                    accept=".mp3,.wav,audio/mpeg,audio/wav"
                >
            </label>

            <label class="file">
                Görsel — JPG
                <input
                    id="songImage"
                    type="file"
                    accept=".jpg,.jpeg,image/jpeg"
                >
            </label>

            <button
                class="primary"
                onclick="publishSong()"
            >
                Şarkıyı Yayınla
            </button>
        `;

    }

    if (type === "community") {

        title.textContent = "💬 Topluluk Mesajı";

        content.innerHTML = `

            <textarea
                id="communityText"
                placeholder="Ne düşünüyorsun?"
            ></textarea>

            <button
                class="primary"
                onclick="publishCommunity()"
            >
                Paylaş
            </button>
        `;

    }

    if (type === "short") {

        title.textContent = "📱 Short İçerik";

        content.innerHTML = `

            <label class="file">
                Video seç
                <input
                    type="file"
                    accept="video/*"
                >
            </label>

            <textarea
                placeholder="Açıklama"
            ></textarea>

            <button
                class="primary"
                onclick="publishShort()"
            >
                Short Paylaş
            </button>
        `;
    }
}


function closeModal() {

    document
        .getElementById("modalBg")
        .classList.remove("show");
}


function publishSong() {

    const name =
        document.getElementById("songName").value.trim();

    if (!name) {

        alert("Şarkı adı zorunlu.");

        return;
    }

    alert("Şarkı yayınlandı! 🎵");

    closeModal();
}


function publishCommunity() {

    const text =
        document.getElementById("communityText").value.trim();

    if (!text) {

        alert("Mesaj yazmalısın.");

        return;
    }

    const feed =
        document.getElementById("feed");

    const post =
        document.createElement("div");

    post.className = "post";

    post.innerHTML = `

        <div class="post-user">

            <div class="avatar">
                ${user.nickname.charAt(0).toUpperCase()}
            </div>

            <div>
                <b>${escapeHTML(user.nickname)}</b><br>
                <small>${user.role} · şimdi</small>
            </div>

        </div>

        <div class="post-content">
            ${escapeHTML(text)}
        </div>

        <div class="post-actions">
            <button class="action" onclick="like(this)">
                ❤️ 0
            </button>

            <button class="action">
                💬 Yorum
            </button>

            <button class="action">
                ↗ Paylaş
            </button>
        </div>
    `;

    feed.prepend(post);

    alert("Topluluk mesajın yayınlandı.");

    closeModal();
}


function publishShort() {

    alert("Short içerik yayınlandı! 📱");

    closeModal();
}


/* LIKE */

function like(button) {

    let number =
        parseInt(button.textContent.match(/\d+/)[0]);

    number++;

    button.textContent =
        "❤️ " + number;
}


/* PROFILE */

function toggleDots() {

    document
        .getElementById("dotsMenu")
        .classList.toggle("show");
}


function shareProfile() {

    const text =
        "MYMSOUND profili: " + user.nickname;

    if (navigator.share) {

        navigator.share({
            title: "MYMSOUND",
            text: text
        });

    } else {

        navigator.clipboard.writeText(text);

        alert("Profil paylaşım metni kopyalandı.");
    }
}


function blockUser() {

    if (
        confirm(
            "Bu hesabı engellemek istediğine emin misin?"
        )
    ) {

        document.getElementById("blockedText")
            .textContent =
            "Engellenen hesap: " + user.nickname;

        alert(
            "Hesap engellendi. Engellenen hesap sana mesaj gönderemez veya seni arayamaz."
        );
    }
}


/* SETTINGS */

function settingsMessage(text) {

    alert(text + " bölümü açıldı.");
}


let nameChanges = 3;


function changeName() {

    const newName =
        document.getElementById("newName").value.trim();

    if (!newName) {

        alert("Yeni mahlasını yaz.");

        return;
    }

    if (nameChanges <= 0) {

        alert(
            "7 günlük isim değiştirme hakkın doldu."
        );

        return;
    }

    user.nickname = newName;

    nameChanges--;

    localStorage.setItem(
        "mymsoundUser",
        JSON.stringify(user)
    );

    document.getElementById("miniName")
        .textContent = newName;

    document.getElementById("profileName")
        .textContent = newName;

    document.getElementById("nameLimit")
        .textContent =
        "İsim değiştirme hakkı: " +
        nameChanges +
        " / 3";

    alert("Mahlasın değiştirildi.");
}


function changeColor(color) {

    document.documentElement
        .style.setProperty("--main", color);

    document.documentElement
        .style.setProperty("--main2", color);
}


/* MESSAGES */

function sendMessage() {

    const input =
        document.getElementById("messageInput");

    const text =
        input.value.trim();

    if (!text) return;

    const message =
        document.createElement("div");

    message.className = "message";

    message.textContent = text;

    document
        .getElementById("chatBody")
        .appendChild(
            document.createElement("br")
        );

    document
        .getElementById("chatBody")
        .appendChild(message);

    input.value = "";
}


/* LOGOUT */

function logout() {

    document.getElementById("app")
        .style.display = "none";

    document.getElementById("auth")
        .style.display = "flex";

    alert("Çıkış yapıldı.");
}


/* GÜVENLİ METİN */

function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;
}


/* SAYFA AÇILIRKEN KAYITLI KULLANICI */

const saved =
    localStorage.getItem("mymsoundUser");

if (saved) {

    try {

        user = JSON.parse(saved);

        if (
            user.email &&
            user.nickname &&
            user.role
        ) {

            startApp();
        }

    } catch(e) {

        localStorage.removeItem(
            "mymsoundUser"
        );
    }
}

</script>

</body>
</html>
